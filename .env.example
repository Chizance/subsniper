# Copy this file to `.env` and fill in real values.
#
# .env is gitignored and should NEVER be committed, pasted into a chat,
# or shared. It lives only on the machine running SubSniper.
#
# On Linux/macOS, lock it down:   chmod 600 .env

# ---- Frontline credentials -------------------------------------------------
FRONTLINE_USERNAME=
FRONTLINE_PASSWORD=

# Some districts require a PIN in addition to the password. Leave blank if not.
FRONTLINE_PIN=

# ---- Pushover --------------------------------------------------------------
# Get these from https://pushover.net
#   USER_KEY  = your user key, shown on the dashboard after login
#   API_TOKEN = create an Application/API Token, name it "SubSniper"
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Optional: restrict notifications to one device instead of all of them
PUSHOVER_DEVICE=
