# systemd unit for Linux. Install with:
#
#   sudo cp deploy/subsniper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now subsniper
#
# Then watch it with:  journalctl -u subsniper -f
#
# Edit User= and the two paths below to match the machine.

[Unit]
Description=SubSniper - Frontline substitute job poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nick
WorkingDirectory=/home/nick/subsniper
Environment=PYTHONPATH=/home/nick/subsniper/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nick/subsniper/.venv/bin/python -m subsniper run

# Always come back up. A poller that dies at 4am and stays dead is the whole
# failure mode this project exists to avoid.
Restart=always
RestartSec=15

# Don't let a crash loop hammer Frontline: if it fails 5 times in 5 minutes,
# stop and wait rather than retrying forever.
StartLimitIntervalSec=300
StartLimitBurst=5

# Modest hardening - this process only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nick/subsniper

[Install]
WantedBy=multi-user.target
